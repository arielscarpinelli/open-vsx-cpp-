{
    "name": "vscode-gcc",
    "displayName": "GCC C/C++",
    "description": "C/C++ diagnostics using GCC and symbols using GCC tree dumps",
    "version": "0.1.0",
    "publisher": "custom-extensions",
    "license": "MIT",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages",
        "Linters"
    ],
    "keywords": [
        "C",
        "C++",
        "gcc"
    ],
    "activationEvents": [
        "onLanguage:c",
        "onLanguage:cpp"
    ],
    "main": "./out/bundle",
    "scripts": {
        "esbuild": "esbuild ./src/extension.ts --bundle --outfile=out/bundle.js --external:vscode --format=cjs --platform=node",
        "vscode:prepublish": "npm run check-ts && npm run esbuild -- --minify --keep-names",
        "compile": "npm run esbuild -- --sourcemap",
        "check-ts": "tsc -noEmit -p ./",
        "test-compile": "tsc -p ./ && npm run compile",
        "test": "npm run test-compile && node ./out/test/index.js"
    },
    "dependencies": {},
    "devDependencies": {
        "@types/glob": "^9.0.0",
        "@types/mocha": "^10.0.7",
        "@types/node": "^25.1.0",
        "@types/vscode": "^1.75.0",
        "@vscode/test-electron": "^2.5.2",
        "esbuild": "^0.27.2",
        "glob": "^13.0.0",
        "mocha": "^11.7.5",
        "typescript": "^5.9.3"
    },
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": false,
            "description": "This extension executes the GCC compiler based on workspace settings, which is not safe for untrusted code."
        }
    },
    "contributes": {
        "commands": [
            {
                "command": "cpp.switchSourceHeader",
                "category": "C/C++",
                "title": "Switch between Source/Header"
            }
        ],
        "keybindings": [
            {
                "command": "cpp.switchSourceHeader",
                "key": "Alt+o",
                "mac": "Alt+cmd+o",
                "when": "editorTextFocus"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "GCC C/C++",
            "properties": {
                "cpp.gccPath": {
                    "type": "string",
                    "default": "gcc",
                    "description": "Path to the GCC executable."
                },
                "cpp.gccFlags": {
                    "type": "array",
                    "default": [],
                    "items": {
                        "type": "string"
                    },
                    "description": "Additional flags to pass to GCC."
                }
            }
        }
    }
}
